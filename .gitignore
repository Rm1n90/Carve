# Brainstorming session artifacts (visual companion server)
.superpowers/

# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / web
node_modules/
dist/
build/
.vite/
.next/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Local data (top-level only; project source dirs may be named "storage" or "data")
/storage/
/data/
/model_cache/
*.sqlite
*.db

# Reference design screenshots (kept locally for design comparison; not tracked)
apps/web/ref-*.png
.playwright-mcp/
.claude/scheduled_tasks.lock

# YOLOE checkpoints (v3.23) — bind-mounted into the model container at
# /app/weights/yoloe. ~150 MB total, not appropriate to track in git.
weights/yoloe/*.pt
state/*.json

# Client-side SAM decode (Stage 4) — decoder ONNX bundles (~22 MB each) +
# onnxruntime-web WASM runtime, provisioned by
# apps/model/scripts/provision_sam_decoders.py. Fetched at deploy, not tracked.
apps/web/public/models/*.onnx
apps/web/public/models/ort/

# DB backup dumps (infra/backup) — never commit data dumps
/backups/
