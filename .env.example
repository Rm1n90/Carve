# SAM model variant. One of: sam2.1-tiny | sam2.1-small | sam2.1-base-plus | sam2.1-large | sam3
# (sam3 requires HuggingFace login + license acceptance; see apps/docs/admin.md)
SAM_MODEL=sam2.1-large

# (Legacy Plan 08 env; honored when SAM_MODEL is unset. Keep for backward compat.)
# SAM_VARIANT=sam2

# bf16 autocast for SAM inference. Default 1 (enabled when CUDA + bf16 supported).
# Set to 0 to force FP32 for debugging.
SAM_BF16=1
