MODEL_HOST=0.0.0.0
MODEL_PORT=8100
MODEL_DEVICE=cuda:0

VITE_API_BASE=/api

CARVE_DOMAIN=localhost
LETSENCRYPT_EMAIL=
# SAM model variant. One of: sam2.1-tiny | sam2.1-small | sam2.1-base-plus | sam2.1-large | sam3
# (sam3 requires HuggingFace login + license acceptance; see apps/docs/admin.md)
SAM_MODEL=sam2.1-large

# (Legacy Plan 08 env; honored when SAM_MODEL is unset. Keep for backward compat.)
# SAM_VARIANT=sam2

# bf16 autocast for SAM inference. Default 1 (enabled when CUDA + bf16 supported).
# Set to 0 to force FP32 for debugging.
SAM_BF16=1

# Optional: torch.compile the SAM model for ~1.3-2x speedup after warmup.
# Adds 30-60s on the first inference call. Default: 0 (disabled).
SAM_COMPILE=0

# Idle eviction window for SAM. After N seconds of no use, the model is
# unloaded from GPU memory. Set 0 to disable. Default: 900 (15 min).
SAM_IDLE_TIMEOUT_S=900
